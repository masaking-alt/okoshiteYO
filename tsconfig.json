{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@theme/*": ["src/theme/*"],
      "@data": ["src/data"],
      "@types": ["src/types"]
    }
  },
  "include": ["src", "App.tsx"],
  "exclude": ["node_modules", "babel.config.js"]
}
